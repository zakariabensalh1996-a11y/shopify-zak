<section
  class="masons-ps"
  id="section-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="masons-ps__content">
    {%- if section.settings.label != blank -%}
      <p class="masons-ps__label">{{ section.settings.label }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="masons-ps__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="masons-ps__body rte">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link }}" class="button button--primary masons-ps__cta">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="masons-ps__media">
    <img
      src="{{ 'masons-personal-shopper.jpg' | asset_url }}"
      alt="Mason's Personal Shopper"
      class="masons-ps__image"
      loading="lazy"
      width="960"
      height="1200"
    >
  </div>
</section>

<style>
  #section-{{ section.id }}.masons-ps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 640px;
    background-color: #ffffff;
  }

  #section-{{ section.id }} .masons-ps__media {
    overflow: hidden;
  }

  #section-{{ section.id }} .masons-ps__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #section-{{ section.id }} .masons-ps__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0;
    padding: 80px 64px;
  }

  #section-{{ section.id }} .masons-ps__label {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #222222;
    margin: 0 0 16px;
    line-height: 1.4;
  }

  #section-{{ section.id }} .masons-ps__heading {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 3.6rem;
    font-weight: 500;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #222222;
    margin: 0 0 24px;
    line-height: 1.1;
  }

  #section-{{ section.id }} .masons-ps__body {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.7;
    color: #222222;
    margin: 0 0 40px;
    max-width: 480px;
  }

  #section-{{ section.id }} .masons-ps__cta {
    display: inline-block;
    background-color: #222222;
    color: #ffffff;
    border: 1px solid #222222;
    padding: 14px 36px;
    font-size: 1.2rem;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s ease-out, border-color 0.25s ease-out;
  }

  #section-{{ section.id }} .masons-ps__cta:hover {
    background-color: #FF5031;
    border-color: #FF5031;
    color: #ffffff;
  }

  @media screen and (max-width: 1024px) {
    #section-{{ section.id }} .masons-ps__content {
      padding: 60px 40px;
    }
  }

  @media screen and (max-width: 768px) {
    #section-{{ section.id }}.masons-ps {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }

    #section-{{ section.id }} .masons-ps__content {
      order: 2;
      padding: 48px 24px;
    }

    #section-{{ section.id }} .masons-ps__media {
      order: 1;
      height: 400px;
    }

    #section-{{ section.id }} .masons-ps__heading {
      font-size: 2.4rem;
    }
  }
</style>

{% schema %}
{
  "name": "Mason's Personal Shopper",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "Label",
      "default": "FOR YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PERSONAL SHOPPER"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Text",
      "default": "<p>Bénéficiez des conseils personnalisés de nos experts pour trouver le pantalon parfait selon votre morphologie, vos goûts et votre style de vie.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Découvrir"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link",
      "default": "/pages/assistant-de-vente"
    }
  ],
  "presets": [
    {
      "name": "Mason's Personal Shopper"
    }
  ]
}
{% endschema %}
