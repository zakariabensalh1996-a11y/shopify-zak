<section
  class="masons-ps"
  id="section-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="masons-ps__content">
    {%- if section.settings.label != blank -%}
      <p class="masons-ps__label">{{ section.settings.label }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="masons-ps__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="masons-ps__body rte">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link }}" class="masons-ps__cta">
        <svg class="masons-ps__whatsapp-icon" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="16" height="16" aria-hidden="true">
          <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}
  </div>

  <div class="masons-ps__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1200
        | image_tag:
          loading: 'lazy',
          class: 'masons-ps__image',
          widths: '600, 800, 960, 1200',
          sizes: '(max-width: 768px) 100vw, 50vw',
          alt: section.settings.heading
      }}
    {%- else -%}
      <img
        src="{{ 'masons-personal-shopper.jpg' | asset_url }}"
        alt="Mason's Personal Shopper"
        class="masons-ps__image"
        loading="lazy"
        width="960"
        height="1200"
      >
    {%- endif -%}
  </div>
</section>

<style>
  #section-{{ section.id }}.masons-ps {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 640px;
    background-color: var(--color-background, #F2F2F2);
  }

  #section-{{ section.id }} .masons-ps__media {
    overflow: hidden;
  }

  #section-{{ section.id }} .masons-ps__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #section-{{ section.id }} .masons-ps__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0;
    padding: 80px 64px;
  }

  #section-{{ section.id }} .masons-ps__label {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #767676;
    margin: 0 0 12px;
    line-height: 1.4;
  }

  #section-{{ section.id }} .masons-ps__heading {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 3.2rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-heading, #000000);
    margin: 0 0 24px;
    line-height: 1.1;
  }

  #section-{{ section.id }} .masons-ps__body {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.75;
    color: #767676;
    margin: 0 0 40px;
    max-width: 46ch;
  }

  /* WhatsApp-styled CTA — green bg */
  #section-{{ section.id }} .masons-ps__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background-color: #25d366;
    color: #ffffff;
    border: none;
    padding: 14px 32px;
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    transition: opacity 0.25s ease-out;
  }

  #section-{{ section.id }} .masons-ps__cta:hover {
    opacity: 0.88;
    color: #ffffff;
  }

  #section-{{ section.id }} .masons-ps__whatsapp-icon {
    flex-shrink: 0;
  }

  @media screen and (max-width: 1024px) {
    #section-{{ section.id }} .masons-ps__content {
      padding: 60px 40px;
    }
  }

  @media screen and (max-width: 768px) {
    #section-{{ section.id }}.masons-ps {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
    }

    #section-{{ section.id }} .masons-ps__content {
      order: 2;
      padding: 48px 24px;
    }

    #section-{{ section.id }} .masons-ps__media {
      order: 1;
      height: 400px;
    }

    #section-{{ section.id }} .masons-ps__heading {
      font-size: 2.4rem;
    }
  }
</style>

{% schema %}
{
  "name": "Mason's Personal Shopper",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave blank to use the default asset."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label (above heading)",
      "default": "FOR YOU"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "PERSONAL SHOPPER"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Text",
      "default": "<p>Avec notre service de Personal Shopper, vous pouvez découvrir les collections lors d'un appel vidéo dédié, en italien ou en anglais, et recevoir des conseils personnalisés pour choisir les pièces parfaites et optimiser votre temps. Achetez immédiatement ou revoyez les looks sélectionnés en toute tranquillité, puis finalisez votre commande quand vous le souhaitez.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "Réservez sur WhatsApp"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Mason's Personal Shopper"
    }
  ]
}
{% endschema %}
