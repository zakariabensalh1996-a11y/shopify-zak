<section
  class="masons-about"
  id="section-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="masons-about__media">
    {%- if section.settings.image != blank -%}
      {{
        section.settings.image
        | image_url: width: 1200
        | image_tag:
          loading: 'lazy',
          class: 'masons-about__image',
          widths: '600, 800, 960, 1200',
          sizes: '(max-width: 768px) 100vw, 50vw',
          alt: section.settings.heading
      }}
    {%- else -%}
      <img
        src="{{ 'masons-about-poster.jpg' | asset_url }}"
        alt="Mason's — About Us"
        class="masons-about__image"
        loading="lazy"
        width="960"
        height="1200"
      >
    {%- endif -%}
  </div>

  <div class="masons-about__content">
    {%- if section.settings.label != blank -%}
      <p class="masons-about__label">{{ section.settings.label }}</p>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}
      <h2 class="masons-about__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}

    {%- if section.settings.body != blank -%}
      <div class="masons-about__body rte">{{ section.settings.body }}</div>
    {%- endif -%}

    {%- if section.settings.btn_label != blank -%}
      <a href="{{ section.settings.btn_link }}" class="masons-about__cta">
        {{ section.settings.btn_label }}
      </a>
    {%- endif -%}

    {%- comment -%} Manifesto words — exact from scraped site {%- endcomment -%}
    <div class="masons-about__manifesto" aria-hidden="true">
      <p>Authentique,</p>
      <p>Libre,</p>
      <p>Élégant.</p>
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.masons-about {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 640px;
    background-color: var(--color-background, #ffffff);
  }

  #section-{{ section.id }} .masons-about__media {
    overflow: hidden;
  }

  #section-{{ section.id }} .masons-about__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    display: block;
  }

  #section-{{ section.id }} .masons-about__content {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0;
    padding: 80px 64px;
    background-color: var(--color-background, #F2F2F2);
  }

  #section-{{ section.id }} .masons-about__label {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.1rem;
    font-weight: 400;
    letter-spacing: 0.25em;
    text-transform: uppercase;
    color: #FF5031;
    margin: 0 0 12px;
    line-height: 1.4;
  }

  #section-{{ section.id }} .masons-about__heading {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 3.2rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-foreground-heading, #000000);
    margin: 0 0 24px;
    line-height: 1.1;
  }

  #section-{{ section.id }} .masons-about__body {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.3rem;
    font-weight: 400;
    line-height: 1.75;
    color: #767676;
    margin: 0 0 32px;
    max-width: 46ch;
  }

  #section-{{ section.id }} .masons-about__cta {
    display: inline-block;
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.1rem;
    letter-spacing: 0.20em;
    text-transform: uppercase;
    color: var(--color-foreground, #000000);
    text-decoration: none;
    border-bottom: 1px solid currentColor;
    padding-bottom: 1px;
    margin-bottom: 40px;
    transition: color 0.25s ease-out;
  }

  #section-{{ section.id }} .masons-about__cta:hover {
    color: #FF5031;
  }

  /* Manifesto — italic, large, stacked */
  #section-{{ section.id }} .masons-about__manifesto {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  #section-{{ section.id }} .masons-about__manifesto p {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: clamp(2.0rem, 3vw, 3.2rem);
    font-weight: 700;
    font-style: italic;
    letter-spacing: -0.01em;
    line-height: 1.15;
    color: var(--color-foreground-heading, #000000);
    margin: 0;
  }

  @media screen and (max-width: 1024px) {
    #section-{{ section.id }} .masons-about__content {
      padding: 60px 40px;
    }
  }

  @media screen and (max-width: 768px) {
    #section-{{ section.id }}.masons-about {
      grid-template-columns: 1fr;
    }

    #section-{{ section.id }} .masons-about__media {
      height: 400px;
    }

    #section-{{ section.id }} .masons-about__content {
      padding: 48px 24px;
    }

    #section-{{ section.id }} .masons-about__heading {
      font-size: 2.4rem;
    }

    #section-{{ section.id }} .masons-about__manifesto p {
      font-size: 2.0rem;
    }
  }
</style>

{% schema %}
{
  "name": "Mason's About",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Leave blank to use the default asset."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Label (above heading)",
      "default": "EST. 1974"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "ABOUT US"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body Text",
      "default": "<p>De la renommée atelier de couture de Vilmo Martini à Carrara à la marque internationale Mason's : découvrez comment, en 1974, son fils Giorgio a transformé le savoir-faire paternel en une aventure entrepreneuriale qui conjugue encore aujourd'hui tradition artisanale et innovation dans l'univers de la mode.</p>"
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Link Label",
      "default": "About Us"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Link URL"
    }
  ],
  "presets": [
    {
      "name": "Mason's About"
    }
  ]
}
{% endschema %}
