<section
  class="masons-stl"
  id="section-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="masons-stl__inner page-width">

    {%- if section.settings.heading != blank -%}
      <header class="masons-stl__header">
        <h2 class="masons-stl__heading">{{ section.settings.heading }}</h2>
        {%- if section.settings.subheading != blank -%}
          <p class="masons-stl__subheading">{{ section.settings.subheading }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="masons-stl__layout">

      {%- comment -%} Editorial image panel {%- endcomment -%}
      <div class="masons-stl__image-panel">
        {%- if section.settings.editorial_image != blank -%}
          {{
            section.settings.editorial_image
            | image_url: width: 960
            | image_tag:
              loading: 'lazy',
              class: 'masons-stl__editorial-image',
              widths: '480, 600, 760, 960',
              sizes: '(max-width: 768px) 100vw, 50vw'
          }}
        {%- else -%}
          <img
            src="{{ 'masons-about-poster.jpg' | asset_url }}"
            alt="Shop The Look"
            class="masons-stl__editorial-image"
            loading="lazy"
            width="960"
            height="1200"
          >
        {%- endif -%}
      </div>

      {%- comment -%} Product list panel {%- endcomment -%}
      <div class="masons-stl__products-panel">
        <p class="masons-stl__products-label">
          {{ section.settings.products_label | default: 'SHOP THE LOOK' }}
        </p>

        <div class="masons-stl__products-list">
          {%- for block in section.blocks -%}
            {%- if block.type == 'product' and block.settings.product != blank -%}
              {%- assign stl_product = block.settings.product -%}
              <a
                href="{{ stl_product.url }}"
                class="masons-stl__product-item"
                {{ block.shopify_attributes }}
              >
                <div class="masons-stl__product-image-wrap">
                  {%- if stl_product.featured_image != blank -%}
                    {{
                      stl_product.featured_image
                      | image_url: width: 240
                      | image_tag:
                        loading: 'lazy',
                        class: 'masons-stl__product-image',
                        widths: '120, 160, 200, 240',
                        sizes: '80px'
                    }}
                  {%- endif -%}
                </div>
                <div class="masons-stl__product-info">
                  <p class="masons-stl__product-title">{{ stl_product.title | upcase }}</p>
                  <p class="masons-stl__product-price">
                    {%- if stl_product.compare_at_price > stl_product.price -%}
                      <span class="price--sale">{{ stl_product.price | money }}</span>
                      <s class="price--compare">{{ stl_product.compare_at_price | money }}</s>
                    {%- else -%}
                      {{ stl_product.price | money }}
                    {%- endif -%}
                  </p>
                </div>
              </a>
            {%- endif -%}
          {%- endfor -%}
        </div>

        {%- if section.settings.cta_label != blank and section.settings.cta_link != blank -%}
          <a href="{{ section.settings.cta_link }}" class="button button--primary masons-stl__cta">
            {{ section.settings.cta_label }}
          </a>
        {%- endif -%}
      </div>

    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.masons-stl {
    background-color: var(--color-background, #F2F2F2);
    padding-block-start: {{ section.settings.padding_top }}px;
    padding-block-end: {{ section.settings.padding_bottom }}px;
  }

  #section-{{ section.id }} .masons-stl__inner {
    display: flex;
    flex-direction: column;
    gap: 40px;
  }

  #section-{{ section.id }} .masons-stl__header {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  #section-{{ section.id }} .masons-stl__heading {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 2.4rem;
    font-weight: 500;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: var(--color-foreground-heading, #222222);
    margin: 0;
    line-height: 1.1;
  }

  #section-{{ section.id }} .masons-stl__subheading {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--color-foreground, #222222);
    margin: 0;
  }

  #section-{{ section.id }} .masons-stl__layout {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    align-items: start;
  }

  #section-{{ section.id }} .masons-stl__image-panel {
    position: sticky;
    top: calc(var(--header-group-height, 80px) + 24px);
    overflow: hidden;
  }

  #section-{{ section.id }} .masons-stl__editorial-image,
  #section-{{ section.id }} .masons-stl__placeholder {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    display: block;
  }

  #section-{{ section.id }} .masons-stl__products-panel {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  #section-{{ section.id }} .masons-stl__products-label {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.0rem;
    font-weight: 400;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--color-foreground, #222222);
    margin: 0;
    border-bottom: 1px solid #E5E5E5;
    padding-bottom: 12px;
  }

  #section-{{ section.id }} .masons-stl__products-list {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  #section-{{ section.id }} .masons-stl__product-item {
    display: grid;
    grid-template-columns: 80px 1fr;
    gap: 16px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid #E5E5E5;
    text-decoration: none;
    color: inherit;
    transition: opacity 0.25s ease-out;
  }

  #section-{{ section.id }} .masons-stl__product-item:hover {
    opacity: 0.7;
  }

  #section-{{ section.id }} .masons-stl__product-image-wrap {
    width: 80px;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    flex-shrink: 0;
  }

  #section-{{ section.id }} .masons-stl__product-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #section-{{ section.id }} .masons-stl__product-title {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.2rem;
    font-weight: 400;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-foreground, #222222);
    margin: 0 0 4px;
    line-height: 1.3;
  }

  #section-{{ section.id }} .masons-stl__product-price {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.2rem;
    font-weight: 400;
    color: var(--color-foreground, #222222);
    margin: 0;
  }

  #section-{{ section.id }} .masons-stl__product-price .price--sale {
    color: var(--color-sale, #FF5031);
  }

  #section-{{ section.id }} .masons-stl__product-price .price--compare {
    color: var(--color-foreground, #222222);
    opacity: 0.5;
    margin-left: 6px;
  }

  #section-{{ section.id }} .masons-stl__cta {
    display: inline-block;
    align-self: flex-start;
    background-color: #222222;
    color: #ffffff;
    border: 1px solid #222222;
    padding: 14px 36px;
    font-size: 1.2rem;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    text-decoration: none;
    transition: background-color 0.25s ease-out, border-color 0.25s ease-out;
  }

  #section-{{ section.id }} .masons-stl__cta:hover {
    background-color: #FF5031;
    border-color: #FF5031;
  }

  @media screen and (max-width: 768px) {
    #section-{{ section.id }} .masons-stl__layout {
      grid-template-columns: 1fr;
    }

    #section-{{ section.id }} .masons-stl__image-panel {
      position: static;
    }
  }
</style>

{% schema %}
{
  "name": "Shop The Look",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "SHOP THE LOOK"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading"
    },
    {
      "type": "image_picker",
      "id": "editorial_image",
      "label": "Editorial Image"
    },
    {
      "type": "text",
      "id": "products_label",
      "label": "Products Label",
      "default": "COMPOSEZ VOTRE LOOK"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA Button Label",
      "default": "Voir tout le look"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "CTA Button Link"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 120,
      "step": 8,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "blocks": [
    {
      "type": "product",
      "name": "Product",
      "settings": [
        {
          "type": "product",
          "id": "product",
          "label": "Product"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Shop The Look"
    }
  ]
}
{% endschema %}
