<section
  class="masons-hero"
  id="section-{{ section.id }}"
  data-section-id="{{ section.id }}"
>
  <div class="masons-hero__media">
    <img
      src="{{ 'masons-hero-ss26.jpg' | asset_url }}"
      alt="{{ section.settings.heading | escape }}"
      class="masons-hero__image"
      loading="eager"
      fetchpriority="high"
      width="1920"
      height="1080"
    >
    <div class="masons-hero__overlay"></div>
  </div>

  <div class="masons-hero__inner page-width">
    <div class="masons-hero__content">
      {%- if section.settings.kicker != blank -%}
        <p class="masons-hero__kicker">{{ section.settings.kicker }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="masons-hero__heading">{{ section.settings.heading }}</h1>
      {%- endif -%}

      <div class="masons-hero__actions">
        {%- if section.settings.btn1_label != blank -%}
          <a href="{{ section.settings.btn1_link }}" class="button button--secondary">
            {{ section.settings.btn1_label }}
          </a>
        {%- endif -%}
        {%- if section.settings.btn2_label != blank -%}
          <a href="{{ section.settings.btn2_link }}" class="button button--secondary">
            {{ section.settings.btn2_label }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

<style>
  #section-{{ section.id }}.masons-hero {
    position: relative;
    width: 100%;
    height: 100svh;
    min-height: 600px;
    overflow: hidden;
    display: flex;
    align-items: flex-end;
  }

  #section-{{ section.id }} .masons-hero__media {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  #section-{{ section.id }} .masons-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
    display: block;
  }

  #section-{{ section.id }} .masons-hero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(34, 34, 34, 0.72) 0%, rgba(34, 34, 34, 0.10) 50%, transparent 100%);
  }

  #section-{{ section.id }} .masons-hero__inner {
    position: relative;
    z-index: 1;
    width: 100%;
    padding-bottom: 60px;
  }

  #section-{{ section.id }} .masons-hero__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
    max-width: 640px;
  }

  #section-{{ section.id }} .masons-hero__kicker {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 1.4rem;
    font-weight: 400;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.80);
    margin: 0;
    line-height: 1.4;
  }

  #section-{{ section.id }} .masons-hero__heading {
    font-family: 'Helvetica Neue', sans-serif;
    font-size: 4.0rem;
    font-weight: 500;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    color: #ffffff;
    margin: 0;
    line-height: 1.1;
  }

  #section-{{ section.id }} .masons-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  #section-{{ section.id }} .masons-hero__actions .button--secondary {
    background-color: transparent;
    border: 1px solid rgba(255, 255, 255, 0.70);
    color: #ffffff;
    padding: 12px 32px;
    font-size: 1.2rem;
    letter-spacing: 0.10em;
    text-transform: uppercase;
    transition: background-color 0.25s ease-out, border-color 0.25s ease-out;
  }

  #section-{{ section.id }} .masons-hero__actions .button--secondary:hover {
    background-color: #ffffff;
    border-color: #ffffff;
    color: #222222;
  }

  @media screen and (max-width: 768px) {
    #section-{{ section.id }} .masons-hero__heading {
      font-size: 2.8rem;
    }

    #section-{{ section.id }} .masons-hero__inner {
      padding-bottom: 40px;
    }

    #section-{{ section.id }} .masons-hero__actions .button--secondary {
      padding: 12px 24px;
    }
  }
</style>

{% schema %}
{
  "name": "Mason's Hero",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "NOUVELLE COLLECTION SS26"
    },
    {
      "type": "text",
      "id": "kicker",
      "label": "Kicker / Subtitle",
      "default": "Découvrez la nouvelle collection : passion artisanale depuis 1974"
    },
    {
      "type": "text",
      "id": "btn1_label",
      "label": "Button 1 Label",
      "default": "Homme"
    },
    {
      "type": "url",
      "id": "btn1_link",
      "label": "Button 1 Link"
    },
    {
      "type": "text",
      "id": "btn2_label",
      "label": "Button 2 Label",
      "default": "Femme"
    },
    {
      "type": "url",
      "id": "btn2_link",
      "label": "Button 2 Link"
    }
  ],
  "presets": [
    {
      "name": "Mason's Hero"
    }
  ]
}
{% endschema %}
