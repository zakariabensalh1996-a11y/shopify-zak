{%- doc -%}
  Renders color swatches for products with a "Couleur" option using a name→hex map.
  Used as fallback when Shopify swatch metadata is not configured.

  @param {object} product_resource - The product object
{%- enddoc -%}

{%- liquid
  assign couleur_option = nil
  for opt in product_resource.options_with_values
    if opt.name == 'Couleur'
      assign couleur_option = opt
      break
    endif
  endfor
-%}

{%- if couleur_option != nil and couleur_option.values.size > 1 -%}
<swatches-variant-picker-component
  data-product-id="{{ product_resource.id }}"
  data-product-url="{{ product_resource.url }}"
  ref="swatchesVariantPicker"
>
  <form>
    <fieldset class="variant-option variant-option--buttons variant-option--swatches">
      {% capture children %}
        {%- for opt_value in couleur_option.values -%}
          {%- liquid
            assign color_name = opt_value.name
            assign swatch_hex = '#cccccc'
            case color_name
              when 'Noir'
                assign swatch_hex = '#111111'
              when 'Blanc'
                assign swatch_hex = '#f5f5f5'
              when 'Gris'
                assign swatch_hex = '#808080'
              when 'Gris Perle'
                assign swatch_hex = '#c8c8c8'
              when 'Gris Clair'
                assign swatch_hex = '#d3d3d3'
              when 'Bleu Marine'
                assign swatch_hex = '#1f3a5f'
              when 'Bleu Nuit'
                assign swatch_hex = '#0d1b2a'
              when 'Bleu Ciel'
                assign swatch_hex = '#87ceeb'
              when 'Marron'
                assign swatch_hex = '#6b3a2a'
              when 'Marron Clair'
                assign swatch_hex = '#a0644c'
              when 'Brique'
                assign swatch_hex = '#b5442e'
              when 'Basalte'
                assign swatch_hex = '#4a4a4a'
              when 'Beige'
                assign swatch_hex = '#d4b896'
              when 'Beige Clair'
                assign swatch_hex = '#e8d5c0'
              when 'Beige Moyen'
                assign swatch_hex = '#c9a87a'
              when 'Sable'
                assign swatch_hex = '#c2a97a'
              when 'Vert Forêt'
                assign swatch_hex = '#2d5016'
              when 'Vert Militaire'
                assign swatch_hex = '#4b5320'
              when 'Stucco'
                assign swatch_hex = '#b8a99a'
              when 'Sauge'
                assign swatch_hex = '#87a878'
              when 'Rose'
                assign swatch_hex = '#f4c2c2'
              when 'Lait'
                assign swatch_hex = '#f5f0e8'
              when 'Beurre'
                assign swatch_hex = '#f5e6a3'
              when 'Crème'
                assign swatch_hex = '#fffdd0'
              when 'Craie'
                assign swatch_hex = '#e8e8e0'
            endcase

            assign featured_media = nil
            assign swatch_option_key = 'option' | append: couleur_option.position
            for variant in product_resource.variants
              if variant[swatch_option_key] == color_name and variant.featured_media
                assign featured_media = variant.featured_media
                break
              endif
            endfor
          -%}
          <li class="variant-option__swatch">
            <label
              data-media-id="{{ featured_media.id }}"
              class="variant-option__button-label variant-option__button-label--has-swatch"
              title="{{ color_name | escape }}"
              on:pointerenter="product-card/previewVariant/{{ featured_media.id }}"
              on:pointerleave="product-card/resetVariant"
            >
              <input
                type="radio"
                name="{{ couleur_option.name | escape }}-{{ product_resource.id }}-swatch"
                value="{{ opt_value | escape }}"
                aria-label="{{ color_name }}"
                data-input-id="{{ couleur_option.position }}-{{ forloop.index0 }}"
                data-option-media-id="{{ featured_media.id }}"
                data-option-value-id="{{ opt_value.id }}"
                data-option-available="{{ opt_value.available }}"
              >
              <span
                class="swatch"
                style="--swatch-background: {{ swatch_hex }};"
              ></span>
              <span class="visually-hidden">{{ color_name }}</span>
            </label>
          </li>
        {%- endfor -%}
        <li slot="more">
          <button
            class="hidden-swatches__count"
            aria-label="{{ 'actions.show_all_options' | t }}"
            on:click="/showAllSwatches"
          ></button>
        </li>
      {% endcapture %}
      {% render 'overflow-list', children: children, ref: 'overflowList' %}
    </fieldset>
    <script type="application/json">
      {{ product_resource.selected_or_first_available_variant | json }}
    </script>
  </form>
</swatches-variant-picker-component>
{%- endif -%}
